{
  "expo": {
    "name": "BallPicker",
    "slug": "ballpicker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/web-app-manifest-512x512.png",
    "scheme": "ballpicker",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "be.vanmalderstudio.ballpicker",
      "buildNumber": "9.0.0",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "BallPicker needs access to your photos so you can choose a profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "be.vanmalderstudio.ballpicker",
      "adaptiveIcon": {
        "backgroundColor": "#07111F",
        "foregroundImage": "./assets/web-app-manifest-512x512.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon-96x96.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "BallPicker needs access to your photos so you can choose a profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ad828c83-b084-4893-b775-905c2e752357"
      }
    }
  }
}