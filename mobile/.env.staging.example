# Point a LOCAL dev build at STAGING (never leave these empty: an empty value
# falls back to PRODUCTION by design — see src/utils/urls.ts).
# Prefer passing them inline when starting Metro, e.g.:
#   EXPO_PUBLIC_API_BASE_URL=https://<staging-host>/api EXPO_PUBLIC_WEB_URL=https://<staging-host> npx expo start --dev-client
EXPO_PUBLIC_API_BASE_URL=https://REPLACE-WITH-STAGING-HOST/api
EXPO_PUBLIC_API_URL=https://REPLACE-WITH-STAGING-HOST/api
EXPO_PUBLIC_WEB_URL=https://REPLACE-WITH-STAGING-HOST
