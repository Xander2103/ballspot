{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "ios": {
        "distribution": "internal",
        "env": {
          "EXPO_PUBLIC_API_BASE_URL": "https://ballpicker.vanmalderstudio.be/api",
          "EXPO_PUBLIC_API_URL": "https://ballpicker.vanmalderstudio.be/api",
          "EXPO_PUBLIC_WEB_URL": "https://ballpicker.vanmalderstudio.be"
        }
      },
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_PUBLIC_API_BASE_URL": "https://ballpicker.vanmalderstudio.be/api",
          "EXPO_PUBLIC_API_URL": "https://ballpicker.vanmalderstudio.be/api",
          "EXPO_PUBLIC_WEB_URL": "https://ballpicker.vanmalderstudio.be"
        }
      }
    },
    "production": {
      "ios": {
        "distribution": "store",
        "autoIncrement": true,
        "env": {
          "EXPO_PUBLIC_API_BASE_URL": "https://ballpicker.vanmalderstudio.be/api",
          "EXPO_PUBLIC_API_URL": "https://ballpicker.vanmalderstudio.be/api",
          "EXPO_PUBLIC_WEB_URL": "https://ballpicker.vanmalderstudio.be"
        }
      },
      "android": {
        "buildType": "app-bundle",
        "env": {
          "EXPO_PUBLIC_API_BASE_URL": "https://ballpicker.vanmalderstudio.be/api",
          "EXPO_PUBLIC_API_URL": "https://ballpicker.vanmalderstudio.be/api",
          "EXPO_PUBLIC_WEB_URL": "https://ballpicker.vanmalderstudio.be"
        },
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6796491992"
      }
    }
  }
}
