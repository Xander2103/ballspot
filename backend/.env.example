APP_NAME=BallPicker
APP_ENV=local
APP_KEY=
# Local development: set APP_DEBUG=true. PRODUCTION MUST BE false — debug mode
# renders stack traces (with request payloads) to users.
APP_DEBUG=false
APP_URL=http://localhost

BALLSPOT_SUPPORT_EMAIL=support@ballspot.app
BALLSPOT_WEB_URL=http://localhost

# Frontend app URL for deep links (password reset). Expo web dev runs on :8081.
# Production: FRONTEND_URL=https://your-production-domain.com
# Optionally override the full reset screen URL (token + email are appended):
#   PASSWORD_RESET_URL=https://your-production-domain.com/reset-password
FRONTEND_URL=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Local development: debug. Production: warning (or error).
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS-only): SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=

# CORS: comma-separated origins allowed to call the API from a browser.
# '*' is for local development only — production MUST list real origins, e.g.
#   CORS_ALLOWED_ORIGINS=https://app.your-domain.com,https://your-domain.com
CORS_ALLOWED_ORIGINS=*

# Reverse-proxy / load-balancer IP(s) or CIDR(s), comma-separated. REQUIRED in
# production behind nginx/a load balancer, or every per-IP rate limit collapses
# into one shared bucket and HTTPS detection misreads the scheme. Empty = trust
# none (correct for local direct-to-PHP dev).
TRUSTED_PROXIES=

# API token lifetime in minutes (empty = tokens never expire).
# Recommended for production: 129600 (90 days).
SANCTUM_TOKEN_EXPIRATION_MINUTES=

# Closed-beta gate: when set, registration requires this code (case-insensitive).
# Leave empty to keep registration open.
BALLPICKER_BETA_CODE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Push notifications (Expo). BALLPICKER_DAILY_REMINDER_PUSH_ENABLED stays false
# until the app build that suppresses local daily reminders is live.
BALLPICKER_PUSH_ENABLED=true
BALLPICKER_DAILY_REMINDER_PUSH_ENABLED=false
BALLPICKER_DEFAULT_REMINDER_TIME=19:00
