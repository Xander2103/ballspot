APP_NAME=BallPicker
APP_ENV=local
APP_KEY=
# Local development: set APP_DEBUG=true. PRODUCTION MUST BE false — debug mode
# renders stack traces (with request payloads) to users.
APP_DEBUG=false
APP_URL=http://localhost

BALLSPOT_SUPPORT_EMAIL=info@vanmalderstudio.be
BALLSPOT_WEB_URL=http://localhost

# Base URL for the password-reset link in the email:
#   {FRONTEND_URL}/reset-password?token=…&email=…
# The BACKEND serves that page (web fallback reset form, v1.9.5), so in
# production this must be the backend domain:
#   FRONTEND_URL=https://ballpicker.vanmalderstudio.be
# Local Expo web dev may point it at :8081 instead. Optionally override the
# full reset URL (token + email are appended):
#   PASSWORD_RESET_URL=https://ballpicker.vanmalderstudio.be/reset-password
FRONTEND_URL=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Release label shown in the admin header and on /admin/diagnostics.
BALLPICKER_APP_VERSION=v1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Local development: debug. Production: warning (or error).
LOG_LEVEL=warning
# Operational event log (storage/logs/ballpicker-events-YYYY-MM-DD.log): keeps
# info-level gameplay/content/auth events even when LOG_LEVEL is warning.
LOG_EVENTS_LEVEL=info
LOG_EVENTS_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS-only): SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=

# CORS: comma-separated origins allowed to call the API from a browser.
# '*' is for local development only — production MUST list real origins, e.g.
#   CORS_ALLOWED_ORIGINS=https://app.your-domain.com,https://your-domain.com
CORS_ALLOWED_ORIGINS=*

# Reverse-proxy / load-balancer IP(s) or CIDR(s), comma-separated. REQUIRED in
# production behind nginx/a load balancer, or every per-IP rate limit collapses
# into one shared bucket and HTTPS detection misreads the scheme. Empty = trust
# none (correct for local direct-to-PHP dev).
TRUSTED_PROXIES=

# API token lifetime in minutes (empty = tokens never expire).
# Recommended for production: 129600 (90 days).
SANCTUM_TOKEN_EXPIRATION_MINUTES=

# Closed-beta gate: when set, registration requires this code (case-insensitive)
# and the app shows its beta-code field (GET /api/config -> beta_gate: true).
# PUBLIC LAUNCH: leave EMPTY — registration is open and the field is hidden.
# Never paste the value into logs, docs, tickets or the app.
BALLPICKER_BETA_CODE=

# Registration email verification (6-digit code). true = code step on (default).
# false = new accounts are verified at once and the verified gate is bypassed
# (emergency switch if mail delivery breaks at launch).
BALLPICKER_REQUIRE_EMAIL_VERIFICATION=true

# Login 2FA (emailed 6-digit code) — OFF for the public launch.
#  - BALLPICKER_FORCE_LOGIN_2FA: true forces the code on EVERY verified login
#    for every user (one email per login). Keep false for launch; the
#    readiness check warns when it is true.
#  - BALLPICKER_LOGIN_2FA_OPT_IN: true lets users switch the code on for
#    themselves in Profile (users.two_factor_enabled). false (launch) hides
#    that toggle in the app and the API refuses new opt-ins; accounts that
#    already have it on keep it and can switch it off. The verification flow
#    itself stays in the backend for a later version.
BALLPICKER_FORCE_LOGIN_2FA=false
BALLPICKER_LOGIN_2FA_OPT_IN=false

# Registration must include password_confirmation. Keep false until the app
# build that sends the field (v1.9.7) is the minimum in the stores; the rule
# is enforced whenever the field is present either way.
BALLPICKER_REQUIRE_PASSWORD_CONFIRMATION=false

# Registration / auth-email abuse ceilings (v1.9.13, App\Support\AuthAbuseGuard).
# Defaults shown. Accounts CREATED per IP; emails SENT per address — form
# typos never count. Every refusal is a 429 with a stable code + a log event.
#BALLPICKER_REGISTER_PER_IP_HOUR=5
#BALLPICKER_REGISTER_PER_IP_DAY=10
#BALLPICKER_REGISTER_ATTEMPTS_PER_EMAIL_HOUR=5
#BALLPICKER_REGISTER_ATTEMPTS_PER_USERNAME_HOUR=5
#BALLPICKER_VERIFICATION_EMAILS_PER_HOUR=5
#BALLPICKER_VERIFICATION_EMAILS_PER_DAY=10
#BALLPICKER_LOGIN_2FA_EMAILS_PER_HOUR=3
#BALLPICKER_LOGIN_2FA_EMAILS_PER_DAY=10
#BALLPICKER_PASSWORD_RESET_PER_EMAIL_HOUR=3
#BALLPICKER_PASSWORD_RESET_PER_IP_HOUR=10

# Registration CAPTCHA (Cloudflare Turnstile) — OFF for launch. Enable only if
# registration spam starts AND the app build that shows the widget is live
# (see docs/security-hardening.md → "If registration spam starts"). When
# enabled, /api/register requires captcha_token (verified server-side).
BALLPICKER_CAPTCHA_ENABLED=false
BALLPICKER_CAPTCHA_PROVIDER=turnstile
BALLPICKER_CAPTCHA_SECRET=
BALLPICKER_CAPTCHA_SITE_KEY=

# Fallback for users.preferred_language (nl|en|fr|de|es) when the app sends none.
BALLPICKER_DEFAULT_LANGUAGE=en

# Automatic daily-challenge scheduling. true (default) = the 00:05 scheduler
# entry runs ballspot:schedule-daily-challenges and fills the next 14 days.
# false = launch control: nothing creates daily_challenges rows automatically
# (a deploy or the nightly cron can never bring cleared dailies back); schedule
# by hand with `php artisan ballspot:schedule-daily-challenges` or Admin → Daily.
# /admin/diagnostics shows the current state.
BALLPICKER_AUTO_SCHEDULE_DAILIES=true

# Automatic daily-challenge ACTIVATION. The scheduler creates rows as
# `scheduled`; the API only serves `active`. true = the 00:10 scheduler entry
# runs ballspot:activate-daily and flips TODAY's scheduled row to active
# (idempotent; never future dates, never archived rows, never an unready photo).
# false (default) = today's daily must be set to Active by hand in Admin → Daily.
# PRODUCTION: set true. Manual activation in Admin keeps working either way.
BALLPICKER_AUTO_ACTIVATE_DAILIES=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Production: keep `database` (or redis). With `file`, every rate-limit
# counter is a file under storage/framework/cache/data; a directory created
# there by root (artisan/cron run as root) made Start Pack and guesses answer
# 500 for some players on 2026-10-15. See docs/ops-runbook.md §5.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Push notifications (Expo). BALLPICKER_DAILY_REMINDER_PUSH_ENABLED stays false
# until the app build that suppresses local daily reminders is live.
BALLPICKER_PUSH_ENABLED=true
BALLPICKER_DAILY_REMINDER_PUSH_ENABLED=false
BALLPICKER_DEFAULT_REMINDER_TIME=19:00

# v1.9.12 share rewards (in-app sharing only — never for store reviews).
# Defaults shown; all limits (once per account / once per calendar day) are
# enforced server-side regardless of these amounts.
#BALLPICKER_SHARE_FIRST_XP=25
#BALLPICKER_SHARE_DAILY_XP=10
#BALLPICKER_SHARE_DAILY_HIGH_SCORE_XP=15
#BALLPICKER_SHARE_HIGH_SCORE_THRESHOLD=80
#BALLPICKER_SHARE_SOCIAL_STRIKER_SHARES=5

# Monitoring / incident alerting (docs/ops-runbook.md §5).
# Rate limiter when its cache store breaks: first the fallback store (limits
# stay enforced), then — only if that fails too — auth/mail limiters answer
# 503 and gameplay fails open. See config/ballspot.php 'rate_limiter'.
#BALLPICKER_RATE_LIMIT_FALLBACK_STORE=database
#BALLPICKER_RATE_LIMIT_FAIL_OPEN=true
# Where scripts/monitor-health.sh sends DOWN / RECOVERED alerts.
#BALLPICKER_ALERT_EMAIL=info@vanmalderstudio.be
# System user php-fpm runs as; the scheduler cron must run as the same user.
#BALLPICKER_WEB_USER=www-data
# Scheduler heartbeat older than this = "scheduler not running" (cron is every 5 min).
#BALLPICKER_SCHEDULER_HEARTBEAT_MAX_MINUTES=15

# BallPicker Clubs feature flag. false (default) = the member API and the club
# portal answer 404 feature_disabled and the app hides the Clubs tab. The
# central admin works either way (clubs can be prepared before launch).
BALLSPOT_CLUBS_ENABLED=false
