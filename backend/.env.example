APP_NAME=BallPicker
APP_ENV=local
APP_KEY=
# Local development: set APP_DEBUG=true. PRODUCTION MUST BE false — debug mode
# renders stack traces (with request payloads) to users.
APP_DEBUG=false
APP_URL=http://localhost

BALLSPOT_SUPPORT_EMAIL=info@vanmalderstudio.be
BALLSPOT_WEB_URL=http://localhost

# Base URL for the password-reset link in the email:
#   {FRONTEND_URL}/reset-password?token=…&email=…
# The BACKEND serves that page (web fallback reset form, v1.9.5), so in
# production this must be the backend domain:
#   FRONTEND_URL=https://ballpicker.vanmalderstudio.be
# Local Expo web dev may point it at :8081 instead. Optionally override the
# full reset URL (token + email are appended):
#   PASSWORD_RESET_URL=https://ballpicker.vanmalderstudio.be/reset-password
FRONTEND_URL=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Release label shown in the admin header and on /admin/diagnostics.
BALLPICKER_APP_VERSION=v1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Local development: debug. Production: warning (or error).
LOG_LEVEL=warning
# Operational event log (storage/logs/ballpicker-events-YYYY-MM-DD.log): keeps
# info-level gameplay/content/auth events even when LOG_LEVEL is warning.
LOG_EVENTS_LEVEL=info
LOG_EVENTS_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS-only): SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=

# CORS: comma-separated origins allowed to call the API from a browser.
# '*' is for local development only — production MUST list real origins, e.g.
#   CORS_ALLOWED_ORIGINS=https://app.your-domain.com,https://your-domain.com
CORS_ALLOWED_ORIGINS=*

# Reverse-proxy / load-balancer IP(s) or CIDR(s), comma-separated. REQUIRED in
# production behind nginx/a load balancer, or every per-IP rate limit collapses
# into one shared bucket and HTTPS detection misreads the scheme. Empty = trust
# none (correct for local direct-to-PHP dev).
TRUSTED_PROXIES=

# API token lifetime in minutes (empty = tokens never expire).
# Recommended for production: 129600 (90 days).
SANCTUM_TOKEN_EXPIRATION_MINUTES=

# Closed-beta gate: when set, registration requires this code (case-insensitive)
# and the app shows its beta-code field (GET /api/config -> beta_gate: true).
# PUBLIC LAUNCH: leave EMPTY — registration is open and the field is hidden.
# Never paste the value into logs, docs, tickets or the app.
BALLPICKER_BETA_CODE=

# Registration email verification (6-digit code). true = code step on (default).
# false = new accounts are verified at once and the verified gate is bypassed
# (emergency switch if mail delivery breaks at launch).
BALLPICKER_REQUIRE_EMAIL_VERIFICATION=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Push notifications (Expo). BALLPICKER_DAILY_REMINDER_PUSH_ENABLED stays false
# until the app build that suppresses local daily reminders is live.
BALLPICKER_PUSH_ENABLED=true
BALLPICKER_DAILY_REMINDER_PUSH_ENABLED=false
BALLPICKER_DEFAULT_REMINDER_TIME=19:00
