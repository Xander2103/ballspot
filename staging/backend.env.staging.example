# Laravel .env for the ISOLATED staging backend (copy to <worktree>/backend/.env).
# Never copy production's .env. Every value below is staging-only; nothing here
# points at production hosts, databases, mail recipients or push recipients.

APP_NAME="BallPicker STAGING"
APP_ENV=staging
APP_KEY=                       # generate on staging only: php artisan key:generate
APP_DEBUG=false
APP_URL=https://REPLACE-WITH-TUNNEL-OR-STAGING-HOST
BALLSPOT_WEB_URL=https://REPLACE-WITH-TUNNEL-OR-STAGING-HOST
FRONTEND_URL=https://REPLACE-WITH-TUNNEL-OR-STAGING-HOST
BALLSPOT_SUPPORT_EMAIL=support@staging.ballpicker.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database: the compose `db` service. The name MUST contain "staging"
# (the staging seeder refuses anything else).
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ballpicker_staging
DB_USERNAME=ballpicker_staging
DB_PASSWORD=                   # = STAGING_DB_PASSWORD from staging/.env

SESSION_DRIVER=database
SESSION_DOMAIN=
# false: the platform admin is used over http://127.0.0.1:8088 (local only);
# the tunnel side is https anyway.
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Trust only the compose network (nginx sets the forwarded headers itself on the
# tunnel-facing server and strips them on the local one), so https URLs incl.
# the signed /media/clubs links are generated and validated with the right scheme.
TRUSTED_PROXIES=172.29.0.0/24

# Mail: everything goes to Mailpit (http://127.0.0.1:8025), never to a real inbox.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@staging.ballpicker.test
MAIL_FROM_NAME="BallPicker STAGING"
BALLPICKER_ALERT_EMAIL=ops@staging.ballpicker.test

# Push: OFF by default. Switch on only for a push QA session; staging tokens
# belong to the QA test devices only (the staging DB never holds real users).
BALLPICKER_PUSH_ENABLED=false
BALLPICKER_DAILY_REMINDER_PUSH_ENABLED=false
# Second barrier: even if push were switched on by mistake, nothing leaves the box.
EXPO_PUSH_URL=http://127.0.0.1:9/push-disabled-on-staging

# Public tunnel: gate new registrations behind a beta code known to testers.
BALLPICKER_BETA_CODE=          # random string, share with testers only
BALLPICKER_CAPTCHA_ENABLED=false
BALLPICKER_REQUIRE_EMAIL_VERIFICATION=true

BALLPICKER_AUTO_SCHEDULE_DAILIES=true
BALLPICKER_AUTO_ACTIVATE_DAILIES=true

# Clubs on (that is what staging is for).
BALLSPOT_CLUBS_ENABLED=true

# Staging seeder (database/seeders/ClubsStagingSeeder.php) — see docs/clubs-staging-seed.md.
BALLPICKER_STAGING_SEED_CONFIRM=
BALLPICKER_STAGING_SEED_PASSWORD=   # >= 12 chars, shared with testers out of band
