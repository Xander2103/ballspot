# Copy to staging/.env (gitignored) and fill in. Used only by docker compose.
# Generate passwords locally, e.g.: openssl rand -base64 24
STAGING_DB_PASSWORD=
STAGING_DB_ROOT_PASSWORD=

# Absolute or relative (to this file) path of the dedicated git worktree.
STAGING_WORKTREE=../../ballspot-staging

# Pin the DB image to the production server's engine + major version once
# verified (e.g. mariadb:10.11 or mysql:8.0).
STAGING_DB_IMAGE=mariadb:11.4

STAGING_WEB_PORT=8088
STAGING_DB_PORT=33070
STAGING_MAILPIT_UI_PORT=8025
